{
  "name": "no-newtab",
  "version": "1.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && vite build --outDir dist-firefox && node scripts/firefox-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test tests",
    "check": "bun test && bun run build && bun run build:firefox"
  },
  "dependencies": {
    "ical.js": "2.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=22"
  }
}
